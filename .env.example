# ---------------------------------------------------------------------------
# RTechX — copy to .env.local and fill in. .env.local is gitignored.
# Never commit real values. Never paste a secret into chat.
# ---------------------------------------------------------------------------

# Public site URL (no trailing slash). Used for canonical URLs and OG images.
NEXT_PUBLIC_SITE_URL="https://www.rtechx.com"

# --- Razorpay ---------------------------------------------------------------
# Start on TEST keys (rzp_test_...) and only switch to live once the full
# order -> signature-verification -> enrolment flow has been proven end to end.
# The Key ID is publishable and reaches the browser. The Key Secret is
# server-only and must never be prefixed NEXT_PUBLIC_.
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET=""
# Set this in the Razorpay dashboard when you enable webhooks.
RAZORPAY_WEBHOOK_SECRET=""

# --- Supabase ---------------------------------------------------------------
# RTechX shares the Organitto project but lives in its own `rtechx` schema,
# so nothing here can see or collide with the Amazon reporting tables.
SUPABASE_SCHEMA="rtechx"
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
# Server-only. Bypasses row-level security — used exclusively inside route
# handlers. If this ever appears in client code, treat it as compromised.
SUPABASE_SERVICE_ROLE_KEY=""

# --- Resend (transactional email) -------------------------------------------
RESEND_API_KEY=""
RESEND_FROM_EMAIL="RTechX <hello@rtechx.com>"

# --- Automation -------------------------------------------------------------
# Every successful enrolment and every lead is POSTed here. Failures are
# swallowed and never block checkout. Leave blank to disable.
N8N_WEBHOOK_URL=""

# --- Analytics (optional; nothing fires until consent is granted) ------------
NEXT_PUBLIC_GA4_MEASUREMENT_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""

# --- Lead magnets -----------------------------------------------------------
# Until this is set, the capture forms and the delivery email both say the
# cheat-sheet is "coming" rather than promising a file that does not exist.
# Drop the PDF at public/resources/ and point this at it.
NEXT_PUBLIC_BOOLEAN_CHEATSHEET_URL=""

# --- Post-purchase ----------------------------------------------------------
# Shown on /thank-you and in the confirmation email.
NEXT_PUBLIC_WHATSAPP_GROUP_URL=""

# ---------------------------------------------------------------------------
# Social automation (branch: social-automation — not live yet)
#
# The daily 9am pipeline: Claude drafts a post, a deterministic pass checks
# every statistic has a named source, a graphic is rendered, and the whole
# thing goes to Telegram for approval. Nothing reaches Instagram or Facebook
# without a tap on Approve.
# ---------------------------------------------------------------------------

# Shared secret between the Netlify schedule and the pipeline route. Any long
# random string; the route refuses to run if this is missing or under 16 chars,
# so an unconfigured trigger fails shut rather than open.
CRON_SECRET=

# console.anthropic.com — a paid API account, separate from a Claude subscription.
ANTHROPIC_API_KEY=

# Meta. This must be a long-lived PAGE access token, not a user token, with
# pages_manage_posts, pages_read_engagement, instagram_basic and
# instagram_content_publish. A user token expires in about an hour.
META_PAGE_ACCESS_TOKEN=
FB_PAGE_ID=113968248289422
IG_USER_ID=28025727383715073

# @BotFather issues the bot token. TELEGRAM_CHAT_ID is the only chat allowed to
# approve a post — the webhook rejects taps from anywhere else, because that
# button is the only thing between a draft and the public feed.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# Optional. Paste current research here and the model works from it rather than
# from memory, which makes a sourced post far more likely than a flagged one.
RESEARCH_NOTES=

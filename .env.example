# ---------------------------------------------------------------------------
# RTechX — copy to .env.local and fill in. .env.local is gitignored.
# Never commit real values. Never paste a secret into chat.
# ---------------------------------------------------------------------------

# Public site URL (no trailing slash). Used for canonical URLs and OG images.
NEXT_PUBLIC_SITE_URL="https://www.rtechx.com"

# --- Razorpay ---------------------------------------------------------------
# Start on TEST keys (rzp_test_...) and only switch to live once the full
# order -> signature-verification -> enrolment flow has been proven end to end.
# The Key ID is publishable and reaches the browser. The Key Secret is
# server-only and must never be prefixed NEXT_PUBLIC_.
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET=""
# Set this in the Razorpay dashboard when you enable webhooks.
RAZORPAY_WEBHOOK_SECRET=""

# --- Supabase ---------------------------------------------------------------
# RTechX shares the Organitto project but lives in its own `rtechx` schema,
# so nothing here can see or collide with the Amazon reporting tables.
SUPABASE_SCHEMA="rtechx"
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
# Server-only. Bypasses row-level security — used exclusively inside route
# handlers. If this ever appears in client code, treat it as compromised.
SUPABASE_SERVICE_ROLE_KEY=""

# --- Resend (transactional email) -------------------------------------------
RESEND_API_KEY=""
RESEND_FROM_EMAIL="RTechX <hello@rtechx.com>"

# --- Automation -------------------------------------------------------------
# Every successful enrolment and every lead is POSTed here. Failures are
# swallowed and never block checkout. Leave blank to disable.
N8N_WEBHOOK_URL=""

# --- Analytics (optional; nothing fires until consent is granted) ------------
NEXT_PUBLIC_GA4_MEASUREMENT_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""

# --- Post-purchase ----------------------------------------------------------
# Shown on /thank-you and in the confirmation email.
NEXT_PUBLIC_WHATSAPP_GROUP_URL=""
